{
  "permissions": {
    "allow": [
      "Read(*)",
      "Bash(*ls*)",
      "Bash(*cat*)",
      "Bash(*cd*)",
      "Bash(*mkdir*)",
      "Bash(*mv*)",
      "Bash(*cp*)",
      "Bash(*echo*)",
      "Bash(*curl * http://127.0.0.1*)",
      "Bash(*curl * http://localhost*)",
      "Bash(*git log*)",
      "Bash(*git status*)",
      "Bash(*git diff*)",
      "Bash(*git add*)",
      "Bash(*git commit*)",
      "Bash(*git branch*)",
      "Bash(*npm*)",
      "Bash(*npx*)",
      "Bash(*node*)",
      "Bash(*ng *)",
      "Bash(*dotnet*)",
      "Bash(*sqlcmd*)"
    ],
    "deny": [
      "Bash(*git push --force*)",
      "Bash(*git push -f *)",
      "Bash(*git reset --hard *)",
      "Bash(*git stash*)",
      "Bash(*git checkout*)",
      "Bash(*git switch -c*)",
      "Bash(*git switch -C*)",
      "Bash(*git switch --create*)",
      "Bash(*git switch --force-create*)",
      "Bash(*rm -rf *)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": []
  },
  "effortLevel": "high"
}
